{
  // Local SOCKS5 inbound (latency path). Point a front-end proxy (e.g.
  // sing-box's socks outbound) here; routing/splitting is its job.
  "listen": "127.0.0.1:1080",

  // Optional second SOCKS5 inbound (bandwidth path): streams ride bonded
  // tunnels — one logical channel striped over several nextppp link
  // connections, multiplying throughput and surviving single-link loss.
  // Aggregation adds per-message scheduling variance, so keep interactive
  // traffic on `listen` and route bulk traffic (downloads, speed tests)
  // here per rule in the front-end proxy. Requires the server's bond
  // listener and "server.bond_address" below.
  // "bond": {
  //     "listen": "127.0.0.1:1081",
  //     "links": 3,
  //     "pool_size": 1,
  //     "max_streams": 64,
  // },

  // Shared tunnel password; must match the server. Backs both
  // obfuscation cipher keys when they are left unset.
  "password": "CHANGE_ME",

  // Remote nextppp server.
  "server": {
    "address": "your.server.example:6666",
    // Link-listener address of the server's bond section; required iff
    // "bond" is configured above.
    // "bond_address": "your.server.example:6667",
    // "connect_timeout": 10,
    // Extra connect attempts after a routine transport failure
    // (RST/timeout). Raises the success rate on RST-bombed links
    // (1-(1-p)^n), at the cost of a more visible connect cadence.
    // "connect_retries": 1,
    // Mux tunnel pool: many SOCKS CONNECTs share a few long-lived
    // tunnels, cutting per-connect cost to ~0 RTT and keeping the
    // thread/fd footprint flat under connection bursts. Streams on one
    // tunnel share its TCP loss fate (head-of-line); pool_size spreads
    // the risk. Set "enabled": false (or pool_size 0) for one dedicated
    // tunnel per CONNECT (the pre-mux behavior).
    // "mux": {
    //     "enabled": true,
    //     "pool_size": 4,
    //     "max_streams": 64,
    // },
    // Must mirror the server configuration (password included).
    // "obfuscation": { ... },
  },
}
