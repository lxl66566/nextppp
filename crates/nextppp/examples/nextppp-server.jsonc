{
  // Listen address for nextppp client connections. One port serves both
  // session roles: plain tunnels and bond links (aggregated-tunnel
  // members), declared by the client in the handshake.
  "listen": "0.0.0.0:6666",

  // Accept bond links. Links are authenticated sessions like plain
  // tunnels, indistinguishable from them on the wire; set false only to
  // forbid the per-client link fan-out pattern on this deployment.
  // "bond_enabled": true,

  // Shared tunnel password. Backs both obfuscation cipher keys when they
  // are left unset; sharing one password is safe (the core KDF separates
  // the two cipher roles). Must be changed per deployment.
  "password": "CHANGE_ME",

  // Outbound (server -> target) connect timeout, seconds.
  "connect_timeout": 10,

  // Handshake timeout, seconds. Raises the cost of slow-loris probing.
  "handshake_timeout": 15,

  // Maximum concurrent in-progress handshakes. Probe floods are dropped
  // at accept time beyond this cap instead of each occupying a session
  // thread for the full handshake_timeout.
  // "max_handshakes": 256,

  // Maximum mux streams per tunnel connection; excess OPENs are answered
  // with CLOSE. Bounds the memory one client can pin on this server.
  // "max_streams_per_conn": 1024,

  // Obfuscation parameters; every field except the passwords feeds the
  // handshake flag-canary, so they must match the client configuration.
  // Per-layer key overrides (seldom needed):
  // "obfuscation": {
  //     "kf": 154543927,
  //     "kl": 10,
  //     "kh": 12,
  //     "kx": 128,
  //     "protocol": "aes-128-cfb",
  //     "protocol_key": "optional, defaults to password",
  //     "transport": "aes-256-ctr",
  //     "transport_key": "optional, defaults to password",
  //     "masked": true,
  //     // true keeps the whole stream printable ASCII (DPI camouflage) at
  //     // ~1.64x wire-byte inflation; false (default) is binary framing.
  //     "plaintext": false,
  //     "delta_encode": true,
  //     "shuffle_data": true,
  // },
}
